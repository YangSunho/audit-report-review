{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  // browser.ts is bundled by esbuild (build-standalone.mjs), not by tsc — it
  // imports core sources directly, which tsc's rootDir would reject.
  "include": ["src"],
  "exclude": ["src/browser.ts", "src/shim-empty.ts"]
}
